<style>
:root{
  --bg:#f1f5f8; --surface:#ffffff; --ink:#12263a; --muted:#52667a;
  --line:#d3dde6; --accent:#1b5fd6; --accent-ink:#ffffff; --code-bg:#12263a; --code-ink:#dbe7f3; --code-key:#7fb2ff; --code-str:#8fe0b0;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0e1a26; --surface:#14253599; --ink:#e6eef6; --muted:#9fb2c4; --line:#27405a; --accent:#6aa3ff; --accent-ink:#0e1a26; --code-bg:#081018;}
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 "Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--accent)}
a:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}
.wrap{max-width:1040px;margin:0 auto;padding:0 1.25rem}
header.top{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 0;flex-wrap:wrap;gap:.75rem}
.brand{font-weight:800;font-size:1.15rem;text-decoration:none;color:var(--ink)}
nav a{margin-left:1.25rem;color:var(--muted);text-decoration:none;font-weight:600}
nav a:hover{color:var(--accent)}

.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;padding:3rem 0 4rem}
h1{font-size:clamp(2.4rem,6vw,4.1rem);line-height:1.04;margin:0 0 1rem;font-weight:800;letter-spacing:-.02em}
.lead{color:var(--muted);max-width:34rem;margin:0 0 1.75rem}
.btns{display:flex;gap:.75rem;flex-wrap:wrap}
.btn{display:inline-block;padding:.75rem 1.3rem;border-radius:8px;font-weight:600;text-decoration:none;border:2px solid var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.btn.ghost{color:var(--accent)}

.resp{background:var(--code-bg);color:var(--code-ink);border-radius:12px;font:400 .9rem/1.7 "JetBrains Mono",ui-monospace,Consolas,monospace;overflow:hidden;box-shadow:0 18px 40px -20px rgba(18,38,58,.55)}
.resp .bar{display:flex;justify-content:space-between;padding:.6rem 1rem;background:rgba(255,255,255,.07);font-size:.8rem}
.resp .ok{color:var(--code-str)}
.resp pre{margin:0;padding:1rem 1.1rem 1.2rem;overflow-x:auto;white-space:pre}
.k{color:var(--code-key)}.s{color:var(--code-str)}

section{padding:3rem 0;border-top:1px solid var(--line)}
h2{font-size:1.9rem;margin:0 0 1.5rem;letter-spacing:-.01em}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem}
.box{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:1.3rem}
.box h3{margin:0 0 .6rem;font-size:1.1rem}
.tags{display:flex;flex-wrap:wrap;gap:.45rem;margin:0;padding:0;list-style:none}
.tags li{border:1px solid var(--line);border-radius:6px;padding:.15rem .6rem;font-size:.92rem;color:var(--muted)}

.job{display:grid;grid-template-columns:11rem 1fr;gap:1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--line)}
.job:last-child{border-bottom:0}
.job .when{color:var(--muted);font-size:.95rem}
.job h3{margin:0 0 .15rem;font-size:1.2rem}
.job .org{color:var(--accent);font-weight:600;margin:0 0 .6rem}
.job ul{margin:0;padding-left:1.1rem}
.job li{margin-bottom:.35rem}

.project{background:var(--surface);border:1px solid var(--line);border-left:6px solid var(--accent);border-radius:10px;padding:1.6rem}
.project h3{margin:0 0 .3rem;font-size:1.35rem}
.project .sub{color:var(--muted);margin:0 0 1rem}
.project ul{padding-left:1.1rem;margin:0 0 1rem}

.contact a.big{display:inline-block;font-size:clamp(1.3rem,3.5vw,2rem);font-weight:800;word-break:break-all;margin-bottom:1.25rem}
.contact ul{list-style:none;padding:0;margin:0;display:grid;gap:.4rem}
footer{padding:2rem 0 3rem;color:var(--muted);font-size:.95rem}

@media (max-width:760px){
